// Job Portal System – Prisma Schema
// ORM: Prisma 7 (prisma-client generator)
// Database: PostgreSQL (Supabase)
// Connection: configured via prisma.config.ts (DIRECT_URL for migrations, DATABASE_URL for runtime)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// In Prisma 7, the datasource url is declared in prisma.config.ts.
// The provider must still be present here so the schema validator can
// resolve PostgreSQL-specific types (Decimal, etc.).
datasource db {
  provider = "postgresql"
}


// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum UserRole {
  JOB_SEEKER
  EMPLOYER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum WorkplaceType {
  ONSITE
  REMOTE
  HYBRID
}

enum ExperienceLevel {
  ENTRY_LEVEL
  JUNIOR
  MID_LEVEL
  SENIOR
  LEAD
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
  REMOVED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  SHORTLISTED
  INTERVIEW
  REJECTED
  HIRED
  WITHDRAWN
}

// ---------------------------------------------------------------------------
// USER
// ---------------------------------------------------------------------------

/// Central identity record. Role-specific data lives in separate profile tables.
model User {
  id        String     @id @default(cuid())
  email     String     @unique
  /// Bcrypt hash – never store plaintext passwords
  password  String
  role      UserRole   @default(JOB_SEEKER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  jobSeekerProfile JobSeekerProfile?
  employerProfile  EmployerProfile?
  /// Jobs this user posted (EMPLOYER only – enforced in application layer)
  postedJobs       Job[]
  /// Applications this user submitted (JOB_SEEKER only – enforced in application layer)
  applications     Application[]
  /// In-app notifications for this user
  notifications    Notification[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// JOB SEEKER PROFILE
// ---------------------------------------------------------------------------

model JobSeekerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  firstName   String
  lastName    String
  headline    String?
  bio         String?
  phone       String?
  location    String?
  /// Supabase Storage path / URL – keep only the reference here
  resumeUrl   String?
  portfolioUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User          @relation(fields: [userId], references: [id])
  education   Education[]
  experience  Experience[]
  skills      JobSeekerSkill[]

  @@map("job_seeker_profiles")
}

// ---------------------------------------------------------------------------
// EMPLOYER PROFILE
// ---------------------------------------------------------------------------

model EmployerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String
  lastName  String
  /// Job title within the company, e.g. "HR Manager"
  jobTitle  String?
  phone     String?
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User    @relation(fields: [userId], references: [id])
  company   Company @relation(fields: [companyId], references: [id])

  @@map("employer_profiles")
}

// ---------------------------------------------------------------------------
// COMPANY
// ---------------------------------------------------------------------------

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  website     String?
  logoUrl     String?
  industry    String?
  size        String?
  location    String?
  foundedYear Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  employers   EmployerProfile[]
  jobs        Job[]

  @@map("companies")
}

// ---------------------------------------------------------------------------
// EDUCATION
// ---------------------------------------------------------------------------

model Education {
  id               String    @id @default(cuid())
  jobSeekerProfileId String
  institution      String
  degree           String
  fieldOfStudy     String?
  startDate        DateTime
  /// Null means currently enrolled
  endDate          DateTime?
  description      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  profile          JobSeekerProfile @relation(fields: [jobSeekerProfileId], references: [id])

  @@index([jobSeekerProfileId])
  @@map("education")
}

// ---------------------------------------------------------------------------
// EXPERIENCE
// ---------------------------------------------------------------------------

model Experience {
  id               String    @id @default(cuid())
  jobSeekerProfileId String
  company          String
  title            String
  employmentType   EmploymentType
  location         String?
  startDate        DateTime
  /// Null means current position
  endDate          DateTime?
  description      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  profile          JobSeekerProfile @relation(fields: [jobSeekerProfileId], references: [id])

  @@index([jobSeekerProfileId])
  @@map("experience")
}

// ---------------------------------------------------------------------------
// SKILL (master catalogue)
// ---------------------------------------------------------------------------

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  // Relations
  jobSeekers JobSeekerSkill[]
  jobs       JobSkill[]

  @@map("skills")
}

// ---------------------------------------------------------------------------
// JOB SEEKER → SKILL (join table)
// ---------------------------------------------------------------------------

model JobSeekerSkill {
  jobSeekerProfileId String
  skillId            String
  /// Optional proficiency label, e.g. "Beginner" / "Expert"
  proficiency        String?

  profile JobSeekerProfile @relation(fields: [jobSeekerProfileId], references: [id])
  skill   Skill            @relation(fields: [skillId], references: [id])

  @@id([jobSeekerProfileId, skillId])
  @@map("job_seeker_skills")
}

// ---------------------------------------------------------------------------
// JOB
// ---------------------------------------------------------------------------

model Job {
  id              String          @id @default(cuid())
  companyId       String
  postedByUserId  String
  title           String
  description     String
  location        String?
  employmentType  EmploymentType
  workplaceType   WorkplaceType   @default(ONSITE)
  experienceLevel ExperienceLevel
  salaryMin       Decimal?        @db.Decimal(12, 2)
  salaryMax       Decimal?        @db.Decimal(12, 2)
  currency        String?         @default("USD")
  applicationDeadline DateTime?
  status          JobStatus       @default(DRAFT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  company         Company         @relation(fields: [companyId], references: [id])
  postedBy        User            @relation(fields: [postedByUserId], references: [id])
  skills          JobSkill[]
  /// Restrict deletion when applications exist – use status transitions (CLOSED/ARCHIVED/REMOVED) instead
  applications    Application[]

  @@index([status])
  @@index([companyId])
  @@index([location])
  @@index([employmentType])
  @@index([workplaceType])
  @@index([experienceLevel])
  @@index([postedByUserId])
  @@map("jobs")
}

// ---------------------------------------------------------------------------
// JOB → SKILL (join table)
// ---------------------------------------------------------------------------

model JobSkill {
  jobId   String
  skillId String

  job   Job   @relation(fields: [jobId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@id([jobId, skillId])
  @@map("job_skills")
}

// ---------------------------------------------------------------------------
// APPLICATION
// ---------------------------------------------------------------------------

model Application {
  id               String            @id @default(cuid())
  jobId            String
  applicantUserId  String
  /// Supabase Storage path/URL for the submitted resume snapshot
  resumeUrl        String?
  coverLetter      String?
  status           ApplicationStatus @default(SUBMITTED)
  /// Internal notes added by employers / admins – not visible to applicant
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  job       Job  @relation(fields: [jobId], references: [id])
  applicant User @relation(fields: [applicantUserId], references: [id])

  /// Prevents duplicate applications at the database level
  @@unique([jobId, applicantUserId])
  @@index([applicantUserId])
  @@index([status])
  @@index([jobId])
  @@map("applications")
}

// ---------------------------------------------------------------------------
// NOTIFICATION
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  /// APPLICATION_STATUS_CHANGE | NEW_APPLICATION
  type      String
  /// Extra metadata (e.g. applicationId, jobId) stored as JSON string
  meta      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
  @@map("notifications")
}
