# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

PORT=5000

# Frontend origin allowed by the backend CORS middleware.
CLIENT_URL="https://job-portal-system-psi.vercel.app"

# Generate two different random secrets of at least 32 characters for each environment.
JWT_ACCESS_SECRET="replace-with-a-random-access-secret-of-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-random-refresh-secret-of-at-least-32-characters"

# First valid login provisions this administrator if the email does not exist yet.
ADMIN_EMAIL="jps@admin.com"
ADMIN_PASSWORD="set-the-admin-password-in-your-private-environment"

# Optional platform Gmail account used for HIRED / REJECTED notifications.
# Create a Google App Password and keep these values in the private .env file.
GMAIL_USER="your-gmail@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-app-password"
GMAIL_FROM_NAME="JobPortal Team"
